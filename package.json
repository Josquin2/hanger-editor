{
  "name": "hanger-editor",
  "version": "0.1.0",
  "description": "Telegram-style markdown editor, rich textarea, parser and safe HTML renderer for Hanger chat",
  "license": "MIT",
  "author": "Josquin <Josquinwork@mail.ru>",
  "keywords": [
    "telegram",
    "discord",
    "markdown",
    "editor",
    "parser",
    "textarea",
    "vue",
    "react",
    "nuxt",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josquin2/hanger-editor.git"
  },
  "homepage": "https://github.com/Josquin2/hanger-editor#readme",
  "bugs": {
    "url": "https://github.com/Josquin2/hanger-editor/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./rich": {
      "types": "./dist/rich.d.ts",
      "import": "./dist/rich.js",
      "require": "./dist/rich.cjs"
    },
    "./rich-textarea.css": "./dist/rich-textarea.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release": "node scripts/release.mjs",
    "release:help": "node scripts/release.mjs --help",
    "release:core": "node scripts/release.mjs core",
    "release:vue": "node scripts/release.mjs vue",
    "release:react": "node scripts/release.mjs react",
    "release:rich": "node scripts/release.mjs rich",
    "release:all": "node scripts/release.mjs all",
    "release:adapters": "node scripts/release.mjs adapters",
    "release:pack": "node scripts/release.mjs all --pack-only",
    "release:dry": "node scripts/release.mjs all --dry-run",
    "test:release": "node --test scripts/release/release.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:docs && pnpm test && pnpm test:release && pnpm build && pnpm docs:build",
    "prepublishOnly": "pnpm check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck:docs": "vue-tsc -p docs/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
